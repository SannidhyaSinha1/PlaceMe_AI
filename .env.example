# ──────────────────────────────────────────────────────────────────────
# PlaceMe AI — environment variables (all services have free tiers)
# Copy to .env and fill in. Everything is OPTIONAL for local dev: with no
# keys at all the app boots on SQLite, and email parsing falls back to
# regex heuristics instead of the LLM.
# ──────────────────────────────────────────────────────────────────────

# Deployment environment: "development" (default) or "production".
# In production the API refuses to boot with the default SECRET_KEY.
ENVIRONMENT=development

# JWT — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Encrypts Gmail OAuth tokens at rest. Optional: defaults to SECRET_KEY.
# Set a dedicated value; changing it invalidates stored tokens (users reconnect).
TOKEN_ENCRYPTION_KEY=

# Supabase PostgreSQL (free 500 MB) — supabase.com → Settings → Database
# Leave empty to use local SQLite (./placementor.db)
SUPABASE_DB_URL=

# ── Email → structured company details ────────────────────────────────
# Groq (free 14,400 req/day) — console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini fallback (free 1M tokens/day) — aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ── Gmail inbox sync ──────────────────────────────────────────────────
# Google OAuth — console.cloud.google.com (enable the Gmail API)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/gmail/callback

# Only emails from this sender are read (default: VIT CDC)
PLACEMENT_EMAIL_SENDER=helpdesk.cdc@vit.ac.in

# How far back to look (Gmail search unit, e.g. 180d)
PLACEMENT_EMAIL_SINCE=180d

# Frontend origin for CORS + OAuth redirects
FRONTEND_ORIGIN=http://localhost:3000
