# ──────────────────────────────────────────────────────────────────────
# PlaceMentor AI — environment variables (all services have free tiers)
# Copy to .env and fill in. Everything is OPTIONAL for local dev:
# with no keys at all the app boots on SQLite and disables AI features.
# ──────────────────────────────────────────────────────────────────────

# Deployment environment: "development" (default) or "production".
# In production the API refuses to boot with the default SECRET_KEY, and both
# FastAPI and Django tighten CORS/host/cookie settings automatically.
ENVIRONMENT=development

# JWT — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Encrypts Gmail OAuth tokens at rest. Optional: defaults to SECRET_KEY.
# Set a dedicated value; changing it invalidates stored tokens (users reconnect).
TOKEN_ENCRYPTION_KEY=

# Comma-separated emails that get admin rights on registration
ADMIN_EMAILS=admin@example.com

# Supabase PostgreSQL (free 500 MB) — supabase.com → Settings → Database
# Leave empty to use local SQLite (./placementor.db)
SUPABASE_DB_URL=

# MongoDB Atlas M0 (free 512 MB) — cloud.mongodb.com
# Used for raw emails, AI content, cached company reports. Optional.
MONGO_URI=

# Upstash Redis (free 10k cmd/day) — console.upstash.com
# Celery broker/backend. Local dev: redis://localhost:6379/0
UPSTASH_REDIS_URL=redis://localhost:6379/0

# Groq (free 14,400 req/day) — console.groq.com/keys
GROQ_API_KEY=

# Gemini fallback (free 1M tokens/day) — aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Tavily web search (free 1,000/month) — tavily.com
TAVILY_API_KEY=

# Cloudinary (free 25 GB) — cloudinary.com
# Optional: without it, PDFs are stored locally under ./uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth for Gmail inbox sync — console.cloud.google.com (enable Gmail API)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/gmail/callback

# Gmail SMTP for deadline reminder emails — myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Restrict Gmail sync to emails from this sender only (default: VIT CDC)
PLACEMENT_EMAIL_SENDER=helpdesk.cdc@vit.ac.in

# Frontend origin for CORS + OAuth redirects
FRONTEND_ORIGIN=http://localhost:3000

# Production-only (ENVIRONMENT=production). Comma-separated.
# DJANGO_ALLOWED_HOSTS: hostnames the Django admin serves (e.g. admin.example.com)
# CORS_ALLOWED_ORIGINS: browser origins allowed to call the Django API
# CSRF_TRUSTED_ORIGINS: origins trusted for Django admin form POSTs
DJANGO_ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
DJANGO_DEBUG=false
