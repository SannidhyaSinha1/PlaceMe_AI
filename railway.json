{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "echo 'no build step — dependencies install from requirements.txt in the install phase'"
  },
  "deploy": {
    "startCommand": "uvicorn fastapi_app.main:app --host 0.0.0.0 --port $PORT --app-dir backend",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
